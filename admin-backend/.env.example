# Admin Backend Configuration

# Server
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8771
ADMIN_API_DEBUG=true

# MultiChain (Tier 3 'Bayanihan' ledger)
# Set MULTICHAIN_ENABLED=false to run the relay without a chain node.
MULTICHAIN_ENABLED=true
# The chain's JSON-RPC port — read `rpcport` from ~/.multichain/<chain>/params.dat
MULTICHAIN_RPC_URL=http://127.0.0.1:4365
# Credentials live in ~/.multichain/<chain>/multichain.conf
MULTICHAIN_RPC_USER=multichainrpc
MULTICHAIN_RPC_PASSWORD=change-me
MULTICHAIN_STREAM_NAME=threat_logs
MULTICHAIN_RPC_TIMEOUT=5.0
# Create + subscribe to the stream on startup if the node doesn't have it yet
MULTICHAIN_AUTO_CREATE_STREAM=true
# Seconds between chain health checks / ledger resyncs
MULTICHAIN_SYNC_INTERVAL=10.0
MULTICHAIN_QUEUE_SIZE=1000
MULTICHAIN_MAX_PUBLISH_ATTEMPTS=5
MULTICHAIN_LEDGER_FETCH_COUNT=200

# Resource telemetry (Chapter 3: "Resource Consumption")
# CPU usage (%) and RAM consumption (MB) are recorded to the telemetry_readings
# table so the mean, sample variance and t-test can be computed later. The paper
# specifies one-minute intervals; the dashboards refresh faster than this and are
# unaffected by it.
TELEMETRY_SAMPLE_INTERVAL=60
# Label the run so scenarios can be told apart, e.g. baseline,
# arp_poison_100pps, arp_flood_1000pps. Leave blank outside a measurement run.
TELEMETRY_SCENARIO=
# Set false to stop recording entirely; dashboards keep working.
TELEMETRY_RECORD=true
